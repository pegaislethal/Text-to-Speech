# ==========================================
# Dependencies
# ==========================================
# node_modules is ignored to prevent committing massive, OS-specific dependency trees.
# Dependencies should be installed via package.json.
node_modules/
/frontend/node_modules/
/backend/node_modules/

# ==========================================
# Environment Variables & Secrets
# ==========================================
# Sensitive credentials and API keys must never be committed to source control.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# ==========================================
# Next.js & Frontend Build Outputs
# ==========================================
# Build directories contain generated output and should not be tracked.
/frontend/.next/
/frontend/out/
/frontend/build/
.next/
out/
build/

# ==========================================
# Backend Build Outputs & Runtime
# ==========================================
/backend/dist/
/backend/build/
*.pid
*.seed
*.pid.lock

# ==========================================
# Logs & Debugging
# ==========================================
# Prevent log files from cluttering the repository.
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# Caches & Temporary Files
# ==========================================
.npm
.eslintcache
.stylelintcache
.tsbuildinfo
.swc/
.temp/
.tmp/
tmp/

# ==========================================
# Operating System Files
# ==========================================
# System-generated metadata files.
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ==========================================
# IDEs & Editor Configuration
# ==========================================
# Personal editor settings should not override project settings.
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ==========================================
# Database & Local Uploads
# ==========================================
# Avoid committing local database dumps and user-uploaded media.
*.sqlite
*.db
/backend/uploads/
/backend/public/uploads/
uploads/

# ==========================================
# Test Coverage
# ==========================================
# Automatically generated reports from test suites.
coverage/
.nyc_output/

# ==========================================
# Media & Generated Output (Audio/AI)
# ==========================================
# Prevent large binary files and auto-generated data from bloating git history.
*.mp3
*.wav
*.ogg
/ai-output/
/generated/

# ==========================================
# Local Configuration Files
# ==========================================
# Any local overrides for developer-specific tools.
config.local.js
config.local.json
